{
  "name": "remeselnicky-portal",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:boundaries": "node scripts/verify-import-boundaries.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && pnpm check:boundaries",
    "lint:workspaces": "turbo run lint",
    "test": "turbo run test && pnpm test:boundaries && pnpm test:recovery",
    "test:boundaries": "node --test scripts/verify-import-boundaries.test.mjs",
    "test:recovery": "node --test infra/postgres/recovery/verify-restore.test.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0",
    "vitest": "catalog:"
  }
}
