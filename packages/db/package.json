{
  "name": "@portal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "migrate": "pnpm build && node dist/migrate-cli.js",
    "test": "vitest run",
    "test:integration": "vitest run test/migration.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@portal/admin-auth": "workspace:*",
    "@portal/analytics": "workspace:*",
    "@portal/audit": "workspace:*",
    "@portal/commands": "workspace:*",
    "@portal/domain": "workspace:*",
    "@portal/media": "workspace:*",
    "@portal/notifications": "workspace:*",
    "@portal/outbox": "workspace:*",
    "@portal/privacy": "workspace:*",
    "@portal/queue": "workspace:*",
    "@portal/search": "workspace:*",
    "@portal/taxonomy": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@portal/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
