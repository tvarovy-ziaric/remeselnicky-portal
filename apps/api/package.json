{
  "name": "@portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/start.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@portal/analytics": "workspace:*",
    "@portal/admin-auth": "workspace:*",
    "@portal/authorization": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/session": "11.1.2",
    "@portal/config": "workspace:*",
    "@portal/contracts": "workspace:*",
    "@portal/db": "workspace:*",
    "@portal/domain": "workspace:*",
    "@portal/media": "workspace:*",
    "@portal/observability": "workspace:*",
    "@portal/search": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@portal/testing": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
