map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server_names_hash_bucket_size 256;

server {
  listen 8080;
  listen 8082 default_server;
  server_name ${ALPHA_APP_HOSTNAME};
  server_tokens off;
  access_log off;
  error_log /dev/stderr crit;
  client_max_body_size 25m;

  auth_basic "Temporary alpha";
  auth_basic_user_file /run/secrets/quick_gate_htpasswd;
  proxy_hide_header Cache-Control;
  add_header Cache-Control "no-store" always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;

  location /v1/ {
    proxy_pass http://api:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location /health/ {
    auth_basic off;
    proxy_pass http://api:3001;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    proxy_pass http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 8080;
  listen 8081 default_server;
  server_name ${ALPHA_OBJECT_HOSTNAME};
  server_tokens off;
  access_log off;
  error_log /dev/stderr crit;
  client_max_body_size 1m;

  proxy_hide_header Cache-Control;
  add_header Cache-Control "no-store" always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

  location / {
    # The alpha object hostname exposes no MinIO admin/internal API. Only the
    # exact opaque private-key shape minted by the portal is proxyable.
    if ($uri !~ "^/${OBJECT_STORAGE_PRIVATE_CONTAINER}/private/[0-9]{4}/[0-9]{2}/[0-9a-f-]{36}$") { return 404; }
    limit_except GET HEAD { deny all; }
    proxy_pass https://minio:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_ssl_server_name on;
    proxy_ssl_name minio;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /run/alpha-tls/ca.crt;
    proxy_ssl_verify_depth 2;
  }
}

server {
  listen 8080 default_server;
  server_name _;
  access_log off;
  error_log /dev/stderr crit;
  return 404;
}
