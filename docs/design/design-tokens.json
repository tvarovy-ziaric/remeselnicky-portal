{
  "project": "Remeselnicky portal",
  "version": "1.0",
  "colors": {
    "background": "#F7F5F0",
    "surface": "#FFFFFF",
    "text": "#202523",
    "mutedText": "#5E6864",
    "primary": "#285C4D",
    "primaryHover": "#224E42",
    "accent": "#C66A42",
    "trust": "#356F8A",
    "success": "#2F7A52",
    "warning": "#B4832E",
    "error": "#B34A3C",
    "border": "#D8D3C8",
    "softBackground": "#EEE8DD"
  },
  "radius": {
    "sm": 10,
    "md": 12,
    "lg": 14,
    "xl": 18
  },
  "shadow": {
    "card": "0 8px 24px rgba(32,37,35,0.08)"
  },
  "typography": {
    "fontSans": ["Inter", "Manrope", "system-ui", "sans-serif"],
    "h1": {"size": 40, "weight": 700, "lineHeight": 1.1},
    "h2": {"size": 28, "weight": 700, "lineHeight": 1.2},
    "h3": {"size": 22, "weight": 600, "lineHeight": 1.25},
    "body": {"size": 16, "weight": 400, "lineHeight": 1.5},
    "small": {"size": 14, "weight": 400, "lineHeight": 1.45}
  },
  "layout": {
    "maxContentWidth": 1200,
    "gutter": 24,
    "sectionSpacing": 40,
    "cardPadding": 24
  },
  "badges": {
    "verified": {"background": "#E5F1EC", "text": "#285C4D"},
    "evidence": {"background": "#E7EFF5", "text": "#356F8A"},
    "declared": {"background": "#F0ECE5", "text": "#5E6864"}
  }
}
